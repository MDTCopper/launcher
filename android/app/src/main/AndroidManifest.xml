<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Access network -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 伪局域网房间：接收 Mindustry 的组播探测（227.2.7.7:20151） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 文件定位（locatedPath）：公开存储路径需存储权限；Android 13+ 旧权限无效，用所有文件访问 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- The bridge answers isVibratorAvailable() by checking this permission. It is an install time
         one, so requestPermissions can never obtain it: without the line below every Vibrator call
         throws and the game is told there is no vibrator. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Features used by Mindustry -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!-- Following Mindustry's own manifest: predictive back is off app-wide, and back arrives as a
         KeyEvent.KEYCODE_BACK instead of an OnBackInvokedCallback - the bridge handles the key event
         (BridgeActivity.onKeyDown), and Flutter keeps handling it through onBackPressed. -->
    <application
        android:label="Copper Launcher"
        android:name="io.github.copper.CopperApplication"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:isGame="true"
        android:appCategory="game"
        android:appComponentFactory="io.github.copper.CopperComponentFactory"
        tools:replace="android:appComponentFactory"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="false">

        <!-- Limits from Mindustry -->
        <meta-data android:name="android.max_aspect" android:value="2.1"/>

        <!-- 输入法只做叠加、不改窗口尺寸：启动器尺寸不受输入法影响，
             输入交给 Dart 侧的全局辅助输入条（浮在键盘上方）承接 -->
        <!-- sensorLandscape：暂时禁用竖屏（竖屏布局还没做）；两个横屏方向都认，
             与游戏 activity 同一口径 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- 登录回调：浏览器授权完由系统把 copperlauncher://oauth/callback?code=… 交回来 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="copperlauncher" android:host="oauth"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 系统分享进来（在 QQ 里对某个 .jar 选「分享」）：宿主把 content:// 复制成本机文件后交给 Dart，
             导入仍走桌面拖入那条路（showResourceImporter 按类型分流）。

             用 activity-alias 是为了让分享面板上那一行文案按文件类型分开 —— 面板显示的是 alias 的 label；
             ACTION_VIEW 也接：「用其他应用打开」与分享是同一条路（那种 intent 的文件在 data 上）。

             ⚠ 2026-10-15 真机实测「QQ 分享 .jar 时面板里没有 Copper」，正在定位：
             `.ShareFile` 临时放宽成 `*/*` 当对照臂（`.ShareJar` 保持具体 MIME）——
             出现「导入 JAR」= 发送方的类型本来就对（问题在别处）；只出现「导入到 Copper」= 白名单漏了它的类型；
             两个都不出现 = 与 MIME 无关。定位完再收窄；实验期系统「打开方式」里也会看到 Copper，属预期噪音 -->
        <activity-alias
            android:name=".ShareJar"
            android:exported="true"
            android:label="导入 JAR"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/java-archive"/>
                <data android:mimeType="application/x-java-archive"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareFile"
            android:exported="true"
            android:label="导入到 Copper"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity-alias>
        <!-- The placeholder both ways of running the game are asked for; CopperComponentFactory
             returns the game's own activity in its place.

             singleTop, not Mindustry's singleTask: the game shares the host's task, and its own
             moveTaskToBack has to move the whole app. configChanges covers everything that would
             recreate an activity holding a running JVM. -->
        <activity
            android:name="io.github.copper.MindustryActivity"
            android:exported="false"
            android:label="@string/mdt_title"
            android:theme="@style/ArcTheme"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:process=":mdt_process"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density|smallestScreenSize">
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
