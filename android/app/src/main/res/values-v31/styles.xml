<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统 splash：Copper 深色底 + 应用图标 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/copper_launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/copper_launch_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <!-- 静默启动：系统 splash 用深色底、不画图标，避免点快捷方式先闪白屏 -->
    <style name="SilentLaunchTheme" parent="@style/LaunchTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/SilentWindowAnimation</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/silent_splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
