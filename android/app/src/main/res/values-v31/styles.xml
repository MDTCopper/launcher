<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 普通启动：白底 + Copper 物品图；快捷启动走 SilentLaunchTheme 保持黑底无图 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/copper_launch_icon_288</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- 游戏 / 桥活动的系统 splash：铜色底、不画图标，和遮罩接上 -->
    <style name="ArcTheme" parent="ArcThemeBase">
        <item name="android:windowSplashScreenBackground">@color/copper_launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- 静默启动：系统 splash 用深色底、不画图标，避免点快捷方式先闪白屏 -->
    <style name="SilentLaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/SilentWindowAnimation</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>






