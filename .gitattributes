# Keep this file byte-for-byte LF; core.autocrlf would otherwise rewrite it on checkout.
.gitattributes -text

# Generator output is written with LF on every platform. Keep it LF in the index too, so Git does not
# warn about converting it to CRLF on Windows checkouts.
android/app/src/main/kotlin/io/github/copper/launcher/generated/** text eol=lf
lib/generated/** text eol=lf
